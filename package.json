{
	"name": "folderr",
	"version": "2.0.0D",
	"description": "A secure open source host for images, and shortened urls..",
	"main": "dist/src/backend/index.js",
	"scripts": {
		"build": "npm run build:backend && npm run build:frontend",
		"build:tsc": "tsc --build && npm run build:frontend",
		"build:frontend": "vite build",
		"build:typecheck": "npm run typecheck && npm run build",
		"build:backend": "swc . --config-file ./.swcrc --ignore dist/**,node_modules/** --copy-files --out-dir dist/",
		"start": "node --enable-source-maps dist/src/backend/index.js",
		"setup": "node dist/scripts/setup.js",
		"dev": "tsx watch --clear-screen=false --ignore \"**vite**\" src/backend/index.ts",
		"test": "eslint --ext .vue,.ts && node dist/src/backend/index.js",
		"lint": "eslint --ext .vue,.ts src/ scripts/ vite.config.ts",
		"lint:fix": "eslint --ext .vue,.ts --fix src/ scripts/ vite.config.ts",
		"typecheck": "tsc --noEmit --skipLibCheck && vue-tsc --noEmit -p src/frontend",
		"installdev": "npm i -D && husky install"
	},
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Folderr/Folderr.git"
	},
	"author": "Folderr",
	"license": "AGPL-3.0",
	"bugs": {
		"url": "https://github.com/Folderr/Folderr/issues"
	},
	"homepage": "https://github.com/Folderr/Folderr#readme",
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/middie": "^9.3.1",
		"@fastify/multipart": "^9.4.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^9.0.0",
		"@headlessui/vue": "^1.7.23",
		"@heroicons/vue": "^1.0.6",
		"@iconify/icons-codicon": "^1.2.30",
		"@iconify/vue": "^3.2.1",
		"@sentry/integrations": "^7.120.3",
		"@sentry/node": "^7.120.3",
		"@sentry/tracing": "^7.120.3",
		"@sentry/vue": "^7.120.3",
		"@tailwindcss/forms": "^0.5.10",
		"ajv": "^8.17.1",
		"argon2": "^0.41.1",
		"envalid": "^7.3.1",
		"fast-glob": "^3.3.3",
		"fastify": "^5.8.2",
		"fastify-plugin": "^4.5.1",
		"fldrr-web-sdk": "github:Folderr/fldrr-web-sdk",
		"got": "^11.8.6",
		"js-yaml": "^4.1.0",
		"jsonwebtoken": "^9.0.2",
		"mime-types": "^2.1.35",
		"moment": "^2.30.1",
		"moment-duration-format": "^2.3.2",
		"mongoose": "^7.8.6",
		"nodemailer": "^6.10.0",
		"pinia": "^2.3.1",
		"pino": "^9.6.0",
		"pino-pretty": "^11.3.0",
		"spdy": "^4.0.2",
		"tsx": "^4.19.2",
		"ulidx": "^2.4.1",
		"uuid": "^8.3.2",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^2.1.4",
		"@iconify/types": "^1.1.0",
		"@swc/cli": "^0.6.0",
		"@types/connect": "^3.4.38",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^8.5.9",
		"@types/mime-types": "^2.1.4",
		"@types/moment-duration-format": "^2.2.6",
		"@types/node": "^18.19.76",
		"@types/nodemailer": "^6.4.17",
		"@types/spdy": "^3.4.9",
		"@types/uuid": "^8.3.4",
		"@vitejs/plugin-vue": "^5.2.1",
		"autoprefixer": "^10.4.20",
		"eslint": "^9.20.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-config-xo": "^0.46.0",
		"eslint-config-xo-typescript": "^6.0.0",
		"eslint-plugin-optimize-regex": "^1.2.1",
		"eslint-plugin-prettier": "^5.2.3",
		"eslint-plugin-unicorn": "^55.0.0",
		"eslint-plugin-vue": "^9.32.0",
		"husky": "^6.0.0",
		"lint-staged": "^11.2.6",
		"postcss": "^8.5.2",
		"prettier": "^3.5.1",
		"swc": "^1.0.11",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.9.3",
		"vite": "^5.4.14",
		"vue-router": "^4.5.0",
		"vue-tsc": "^2.2.2"
	},
	"lint-staged": {
		"*.{ts,vue}": "eslint --ext .vue,.ts --fix",
		"*.{md,yaml}": "prettier --write"
	}
}
