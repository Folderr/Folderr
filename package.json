{
	"name": "folderr",
	"version": "2.0.0D",
	"description": "A secure open source host for images, and shortened urls..",
	"main": "dist/src/backend/index.js",
	"scripts": {
		"build": "npm run build:backend && npm run build:frontend",
		"build:tsc": "tsc --build && npm run build:frontend",
		"build:frontend": "vite build",
		"build:typecheck": "npm run typecheck && npm run build",
		"build:backend": "swc . --config-file ./.swcrc --ignore dist/**,node_modules/** --copy-files --out-dir dist/",
		"start": "node --enable-source-maps dist/src/backend/index.js",
		"setup": "node dist/scripts/setup.js",
		"dev": "tsx watch --clear-screen=false --ignore \"**vite**\" src/backend/index.ts",
		"test": "biome check . && node dist/src/backend/index.js",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit --skipLibCheck && vue-tsc --noEmit -p src/frontend",
		"installdev": "npm i -D && lefthook install"
	},
	"type": "module",
	"engines": {
		"node": ">=22.12.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Folderr/Folderr.git"
	},
	"author": "Folderr",
	"license": "AGPL-3.0",
	"bugs": {
		"url": "https://github.com/Folderr/Folderr/issues"
	},
	"homepage": "https://github.com/Folderr/Folderr#readme",
	"dependencies": {
		"@fastify/cookie": "^11.0.2",
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/multipart": "^9.4.0",
		"@fastify/rate-limit": "^10.3.0",
		"@fastify/static": "^10.1.7",
		"@fastify/swagger": "^9.7.0",
		"@headlessui/vue": "^1.7.23",
		"@heroicons/vue": "^1.0.6",
		"@iconify-icons/codicon": "^2.0.8",
		"@iconify/vue": "^3.2.1",
		"@scalar/fastify-api-reference": "^1.48.0",
		"@sentry/integrations": "^7.120.3",
		"@sentry/node": "^7.120.3",
		"@sentry/tracing": "^7.120.3",
		"@sentry/vue": "^7.120.3",
		"@tailwindcss/forms": "^0.5.11",
		"ajv": "^8.17.1",
		"argon2": "^0.41.1",
		"envalid": "^7.3.1",
		"fast-glob": "^3.3.3",
		"fastify": "^5.8.2",
		"fastify-plugin": "^4.5.1",
		"fldrr-web-sdk": "github:Folderr/fldrr-web-sdk",
		"got": "^11.8.6",
		"js-yaml": "^4.1.0",
		"jsonwebtoken": "^9.0.2",
		"mime-types": "^2.1.35",
		"moment": "^2.30.1",
		"moment-duration-format": "^2.3.2",
		"mongoose": "^7.8.6",
		"nodemailer": "^10.2.1",
		"pinia": "^2.3.1",
		"pino": "^9.6.0",
		"pino-pretty": "^11.3.0",
		"ulidx": "^2.4.1",
		"vue": "^3.5.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@swc/cli": "^0.8.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/connect": "^3.4.38",
		"@types/js-yaml": "^4.0.9",
		"@types/jsonwebtoken": "^8.5.9",
		"@types/mime-types": "^2.1.4",
		"@types/moment-duration-format": "^2.2.6",
		"@types/node": "^22.20.5",
		"@types/nodemailer": "^8.0.2",
		"@vitejs/plugin-vue": "^6.0.10",
		"lefthook": "2.2.2",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vite": "^8.3.5",
		"vue-router": "^4.5.0",
		"vue-tsc": "^2.2.2"
	}
}
